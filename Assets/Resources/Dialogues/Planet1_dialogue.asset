    options:
    - text: Cool. How much?
      nextNode: 1
      updatesPlanetNode: 1
      newPlanetNode: 1
      triggersEvent: 0
      eventId: 
    - text: Yeah, maybe later
      nextNode: -1
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: 
  - npcText: '3,000 points and The Shotgun is yours. '
    options:
    - text: I have enough points.
      nextNode: 2
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 1
      eventId: CHECKPOINTS
    - text: 'Okay, I will be back soon. '
