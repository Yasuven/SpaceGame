    options:
    - text: Yes.
      nextNode: -1
      updatesPlanetNode: 1
      newPlanetNode: 3
      triggersEvent: 1
      eventId: SHOTGUN
    - text: 'Not this time. '
      nextNode: -1
      updatesPlanetNode: 1
      newPlanetNode: 3
      triggersEvent: 0
      eventId: 
  - npcText: How do you like the Shotgun? You do not have to answer. We know you
