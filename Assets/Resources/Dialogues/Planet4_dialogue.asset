  m_Script: {fileID: 11500000, guid: 60c35c21a36994c0fa28086cfac5743f, type: 3}
  m_Name: Planet4_dialogue
  m_EditorClassIdentifier: 
  nodes:
  - npcText: Stranger. Welcome to our intergalactic, quantum-randomized casino.
    options:
    - text: ...
      nextNode: 1
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: 
  - npcText: You are not on our previous guest list. Let us introduce you to the
      rules of our casino game.
    options:
    - text: Go on.
      nextNode: 2
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: 
  - npcText: "We play with all the points on your account \u2013 specifically, the
      sum of their digits. For example, if your current points are 16,765, then the
      sum is 1 + 6 + 7 + 6 + 5 = 25."
    options:
    - text: Then what?
      nextNode: 3
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: 
  - npcText: 'Then we summon our quantum randomizer to choose the condition of victory:
      the sum must be odd, even, or divisible by 3 or 5. If the sum satisfies the
      chosen condition, you win. Otherwise, we win.'
    options:
    - text: Am I supposed to trust computer in randomisation?
      nextNode: 4
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: 
  - npcText: Do you not trust computers all the time? If you win, we multiply your
      points by 1.5. If you lose, we take half of the points. If you would end up
      with fewer than 2,000 points, we take no points. We take your spaceship.
    options:
    - text: 'Okay. Right. '
      nextNode: 5
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: 
  - npcText: "No worries. We will give you a spare ship \u2013\_it does the job.
      But you are not welcome in the casino while flying it. All clear, or should
      we repeat the rules?"
    options:
    - text: 'All clear. '
      nextNode: 10
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: 
    - text: Repeat please
      nextNode: 6
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: 
  - npcText: We use the sum of the digits in your account. For example, 16,765 becomes
      1 + 6 + 7 + 6 + 5 = 25.
    options:
    - text: Okay.
      nextNode: 7
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: 
  - npcText: 'Then we summon the quantum randomizer to choose the victory condition:
      odd, even, or divisible by 3 or 5. If the sum meets the condition, you win.
      Otherwise, we win.'
    options:
    - text: 'Mkay. '
      nextNode: 8
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: 
  - npcText: "Win and your points increase by 1.5\xD7. Lose and we take half of everything
      you have."
    options:
    - text: 'Mkay. '
      nextNode: 9
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: 
  - npcText: If you would end up with fever than 2,000 points, we take no points.
      We take your ship and give you a spare instead. All clear, or should we repeat?
    options:
    - text: All clear.
      nextNode: 10
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: 
    - text: 'Repeat please. '
      nextNode: 6
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: 
  - npcText: Shall we play?
    options:
    - text: Yes.
      nextNode: 11
      updatesPlanetNode: 1
      newPlanetNode: 10
      triggersEvent: 0
      eventId: 
    - text: No.
      nextNode: -1
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 1
      eventId: VISITED
  - npcText: "Then we summon the intergalactic quantum randomizer! It declares that
      we check whether your point digits are\u2026"
    options:
    - text: ...
      nextNode: 0
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 1
      eventId: RANDOMIZER
  - npcText: '... odd! Well, you... '
    options:
    - text: ...
      nextNode: 0
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 1
      eventId: RANDOMIZER_ODD
  - npcText: '... even! And you have... '
    options:
    - text: ...
      nextNode: 0
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 1
      eventId: RANDOMIZER_EVEN
  - npcText: ... divisible by 3. So...
    options:
    - text: ...
      nextNode: 0
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 1
      eventId: RANDOMIZER_DIVISIBLE3
  - npcText: '... divisible by 5. You... '
    options:
    - text: ...
      nextNode: 0
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 1
      eventId: RANDOMIZER_DIVISIBLE5
  - npcText: ".. you won! Well \u2013\_want to try again? "
    options:
    - text: Yes!
      nextNode: 11
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: RANDOMIZER_ODD
    - text: 'Maybe next time. '
      nextNode: -1
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: RANDOMIZER_ODD
  - npcText: ... you lost. Your ship is now ours. Come back when you have points
      or a proper ship.
    options:
    - text: Damn.
      nextNode: -1
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: RANDOMIZER_ODD
  - npcText: "\u2026you lost. You still have some points. Want to try again?"
    options:
    - text: 'You know... I better go. '
      nextNode: -1
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: RANDOMIZER_ODD
    - text: Yeah, let's try!
      nextNode: 11
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: 
  - npcText: This is respectable intergalactic quantum-randomized casino. Get more
      than 2,000 points to enter.
    options:
    - text: Ok, I will.
      nextNode: -1
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: RANDOMIZER_ODD
  - npcText: You cannot enter our respectable casino while flying this garbage.
    options:
    - text: 'But... you gave it to me... Fine. '
      nextNode: -1
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: 
