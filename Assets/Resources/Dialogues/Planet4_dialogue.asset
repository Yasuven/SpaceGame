    - text: Ok, I will.
      nextNode: -1
      updatesPlanetNode: 0
      newPlanetNode: 0
      triggersEvent: 0
      eventId: RANDOMIZER_ODD
  - npcText: 'You can not enter our respectable casino while flying this garbage. '
